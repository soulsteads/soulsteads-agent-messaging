# Example environment for soulsteads-messaging.
#
# Copy this file, keep only the connectors you use, and fill in real values.
# The bridge reads .env, .env.<NODE_ENV> and .env.local from its working
# directory; real environment variables take precedence. Never commit real
# values. The guided Telegram setup instead takes a private file outside this
# checkout (`--env-file`), readable only by you (chmod 600).
#
# Everything here is optional. Enable each connector in the configuration
# file (soulsteads-messaging.json); see docs/SETUP.md.

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot.
TELEGRAM_ALLOWED_USERS=
# Optional prefix that starts a request (overrides "trigger" in the config).
# TELEGRAM_TRIGGER=

# --- Matrix -----------------------------------------------------------------
MATRIX_USER_ID=
# Use an access token, or a password; the token is preferred.
MATRIX_ACCESS_TOKEN=
# MATRIX_PASSWORD=
# MATRIX_ALLOWED_USERS=
# Where Matrix state and encryption keys are stored.
# MATRIX_STORAGE_PATH=

# --- Mattermost -------------------------------------------------------------
MATTERMOST_URL=
MATTERMOST_TOKEN=
# MATTERMOST_TEAM=
# MATTERMOST_ALLOWED_USERS=

# --- Slack (Socket Mode needs both tokens) -----------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# SLACK_ALLOWED_USERS=

# --- Discord ----------------------------------------------------------------
DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_USERS=

# --- WhatsApp ---------------------------------------------------------------
# Set to false to ignore messages from other people.
# WHATSAPP_RESPOND_TO_OTHERS=true
# WHATSAPP_ALLOWED_USERS=

# --- Web interface ----------------------------------------------------------
# WEB_HOST=127.0.0.1
# WEB_PORT=3420
# WEB_PUBLIC_URL=
# Comma-separated list of browser origins allowed to connect.
# WEB_ALLOWED_ORIGINS=

# --- General ----------------------------------------------------------------
# Where chat sessions are stored.
# SESSION_BASE_DIR=
